{
  "name": "simple-glb-editor",
  "version": "0.1.0",
  "description": "Simple browser GLB editor: rig, stick-figure skeleton, vertex/edge edit, animate, loop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "node scripts/vendor.js && electron-builder --win portable",
    "icon": "electron scripts/render-icon.js"
  },
  "author": "",
  "license": "PolyForm-Small-Business-1.0.0",
  "type": "commonjs",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "qrcode-generator": "1.4.4",
    "three": "^0.160.0",
    "three-bvh-csg": "0.0.16",
    "three-mesh-bvh": "0.7.8"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "build": {
    "appId": "local.simple-glb-editor",
    "productName": "Simple GLB Editor",
    "files": [
      "main.js",
      "preload.js",
      "agents/**",
      "server.js",
      "index.html",
      "watch.html",
      "styles.css",
      "icon.svg",
      "icon.png",
      "src/**",
      "vendor/**",
      "package.json"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "SimpleGLBEditor.exe"
    }
  }
}
